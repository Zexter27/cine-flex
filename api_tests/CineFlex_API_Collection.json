          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('exito es false', () => pm.expect(pm.response.json().exito).to.be.false);",
              "pm.test('mensaje de numero de tarjeta invalido', () => pm.expect(pm.response.json().mensaje).to.include('La información enviada no es válida'));"
            ],
