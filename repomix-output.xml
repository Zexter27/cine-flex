<file path="backend/src/dto/validar-dto.ts">
import { plainToInstance } from "class-transformer";
import { validate, type ValidationError } from "class-validator";
import type { NextFunction, Request, Response } from "express";
import { crearRespuesta } from "../comun/respuesta-http";

type ConstructorDto<T extends object> = new () => T;

function obtenerDetallesValidacion(errores: ValidationError[]): string[] {
  return errores.flatMap((error) => [
    ...Object.values(error.constraints ?? {}),
    ...obtenerDetallesValidacion(error.children ?? [])
  ]);
}

export function validarDto<T extends object>(tipoDto: ConstructorDto<T>) {
  return async (solicitud: Request, respuesta: Response, siguiente: NextFunction) => {
    const dto = plainToInstance(tipoDto, solicitud.body);
    const errores = await validate(dto, { whitelist: true, forbidNonWhitelisted: true });

    if (errores.length > 0) {
      return respuesta.status(400).json(
        crearRespuesta(
          false,
          "La información enviada no es válida. Revisa los campos indicados.",
          obtenerDetallesValidacion(errores)
        )
      );
    }

    solicitud.body = dto;
    return siguiente();
  };
}
</file>

<file path="backend/src/middlewares/autenticacion.middleware.ts">
import type { NextFunction, Request, Response } from "express";
import { crearRespuesta } from "../comun/respuesta-http";
import { tokenValido } from "../servicios/autenticacion.servicio";

export function requerirToken(solicitud: Request, respuesta: Response, siguiente: NextFunction) {
  const autorizacion = solicitud.get("authorization") ?? "";
  const coincidencia = autorizacion.match(/^Bearer\s+(.+)$/i);

  if (!coincidencia || !tokenValido(coincidencia[1])) {
    return respuesta.status(401).json(
      crearRespuesta(false, "Debes iniciar sesión con un token válido para acceder a este recurso.", null)
    );
  }
  return siguiente();
}
</file>

<file path="backend/src/middlewares/errores.middleware.ts">
import type { ErrorRequestHandler, RequestHandler } from "express";
import { ErrorAplicacion } from "../comun/error-aplicacion";
import { crearRespuesta } from "../comun/respuesta-http";

export const rutaNoEncontrada: RequestHandler = (_solicitud, respuesta) => {
  respuesta.status(404).json(
    crearRespuesta(false, "La ruta solicitada no existe. Verifica la dirección y el método HTTP.", null)
  );
};

export const manejarErrores: ErrorRequestHandler = (error: unknown, _solicitud, respuesta, _siguiente) => {
  if (error instanceof ErrorAplicacion) {
    return respuesta.status(error.codigoHttp).json(
      crearRespuesta(false, error.message, null)
    );
  }

  if (
    typeof error === "object" &&
    error !== null &&
    "type" in error
  ) {
    if (error.type === "entity.parse.failed") {
      return respuesta.status(400).json(
        crearRespuesta(false, "El cuerpo de la solicitud contiene JSON mal formado.", null)
      );
    }
    if (error.type === "entity.too.large") {
      return respuesta.status(413).json(
        crearRespuesta(false, "El cuerpo de la solicitud supera el tamaño máximo permitido.", null)
      );
    }
  }

  console.error("Ocurrió un error inesperado al procesar la solicitud.", error);
  return respuesta.status(500).json(
    crearRespuesta(false, "Ocurrió un error interno. Intenta nuevamente más tarde.", null)
  );
};
